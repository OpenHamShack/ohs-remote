{
  "about": "OpenHamShack Remote's standard key map (openhamshack docs/REMOTE-KEYS.md section 4, accepted by Brian 11/10/2026). The source of truth for every platform: Android's KeyMap.kt and the Apple twin are tested against this file line for line (KeyMapTest), so a change to the map is made here and in both in one commit.",
  "version": 1,
  "gestures": {
    "press": "OK, Menu and Play/Pause: on key up, unless the hold fired. Every other key: on key down.",
    "hold": "OK and Menu after holdMs.ok; Play/Pause after holdMs.play_pause. Fires once; the key's release then does nothing.",
    "repeat": "Android's key repeat while a key without a hold is held."
  },
  "holdMs": {
    "ok": 500,
    "menu": 500,
    "play_pause": 1000
  },
  "transmit": {
    "armMs": 5000,
    "arm": "play_pause hold",
    "confirm": [
      "ok press",
      "play_pause press"
    ],
    "whileArmed": "any other key disarms",
    "whileOn": "any key stops and does nothing else"
  },
  "overlayIdleMs": 8000,
  "bindings": [
    {"class": "radio", "key": "left", "gesture": "press", "action": "tune:down"},
    {"class": "radio", "key": "right", "gesture": "press", "action": "tune:up"},
    {"class": "radio", "key": "left", "gesture": "repeat", "action": "tune:down"},
    {"class": "radio", "key": "right", "gesture": "repeat", "action": "tune:up"},
    {"class": "radio", "key": "up", "gesture": "press", "action": "choose"},
    {"class": "radio", "key": "down", "gesture": "press", "action": "focus:down"},
    {"class": "radio", "key": "ok", "gesture": "press", "action": "controls"},
    {"class": "radio", "key": "ok", "gesture": "hold", "action": "frequency"},
    {"class": "radio", "key": "back", "gesture": "press", "action": "back"},
    {"class": "radio", "key": "menu", "gesture": "press", "action": "settings"},
    {"class": "radio", "key": "menu", "gesture": "hold", "action": "help"},
    {"class": "radio", "key": "play_pause", "gesture": "press", "action": "mute"},
    {"class": "radio", "key": "play_pause", "gesture": "hold", "action": "transmit"},
    {"class": "radio", "key": "rewind", "gesture": "press", "action": "step:down"},
    {"class": "radio", "key": "fast_forward", "gesture": "press", "action": "step:up"},
    {"class": "radio", "key": "channel_up", "gesture": "press", "action": "band:next"},
    {"class": "radio", "key": "channel_down", "gesture": "press", "action": "band:prev"},
