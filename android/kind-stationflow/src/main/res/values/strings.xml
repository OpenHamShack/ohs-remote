<?xml version="1.0" encoding="utf-8"?>
<!--
  The Icom kind's English catalog (docs/I18N.md). The kind's own, apart from
  the host app's, because the kind is a library that moves into
  OpenHamShack Remote whole. Whole sentences with numbered placeholders;
  callsigns, mode names (FT8, USB-D) and frequencies arrive through the
  placeholders already formatted and are never translated. Layouts leave
  room for text 40% longer than this.
-->
