<?xml version="1.0" encoding="utf-8"?>
<!--
  The shared kit's English catalog (docs/I18N.md): words its own composables
  show, whichever kind uses them. Its own, apart from the host app's and the
  kinds', because this module becomes the family's :core and moves whole.
  Names are prefixed core_ so they cannot collide with a host's entries when
  the resources merge.
-->
<resources>
    <!-- The TV text dialog's two buttons -->
    <string name="core_ok">OK</string>
    <string name="core_cancel">Cancel</string>
    <!-- A character decoder's strip: the mode and the sender's speed ("CW · 18.0 WPM") -->
    <string name="core_decoded_wpm">%1$s · %2$s WPM</string>

    <!-- Remote keys (openhamshack docs/REMOTE-KEYS.md): the key legend, the transient hints, transmit's arm overlay -->
    <!-- The keys of a TV remote as the legend names them -->
    <string name="core_key_ok">OK</string>
    <string name="core_key_back">Back</string>
    <string name="core_key_menu">Menu ☰</string>
    <string name="core_key_channel_up">CH +</string>
    <string name="core_key_channel_down">CH −</string>
    <string name="core_key_info">Info</string>
    <string name="core_key_digits">0–9</string>
    <!-- A key held rather than pressed: "OK held", "Menu ☰ held" -->
    <string name="core_key_held">%1$s held</string>
    <!-- What a key does, in the legend and the hints -->
    <string name="core_action_tune_down">Tune down</string>
    <string name="core_action_tune_up">Tune up</string>
    <string name="core_action_step_down">Smaller step</string>
    <string name="core_action_step_up">Larger step</string>
    <string name="core_action_band_prev">Previous band</string>
    <string name="core_action_band_next">Next band</string>
    <string name="core_action_channel_prev">Previous channel</string>
    <string name="core_action_channel_next">Next channel</string>
    <string name="core_action_choose">Choose</string>
    <string name="core_action_controls">Quick controls</string>
    <string name="core_action_focus_down">Down to the controls</string>
    <string name="core_action_frequency">Type a frequency</string>
    <string name="core_action_settings">Settings</string>
    <string name="core_action_help">These keys</string>
    <string name="core_action_mute">Mute or unmute</string>
    <string name="core_action_transmit">Transmit: hold, then OK to start</string>
    <string name="core_action_back">Close, then leave</string>
    <!-- The legend -->
    <string name="core_legend_title">Remote keys</string>
    <string name="core_legend_unused">—</string>
    <string name="core_legend_tv_own">Home and the voice key are the TV\'s own</string>
    <string name="core_legend_close">Back or OK closes this</string>
    <!-- Transmit, armed then confirmed -->
    <string name="core_tx_armed_keys">OK or ▶❚❚ to start  ·  any other key cancels</string>
    <!-- Seconds left to confirm -->
    <string name="core_tx_countdown">%1$d s</string>
    <string name="core_tx_starting">Starting…</string>
    <string name="core_tx_on_keys">Any key stops</string>
    <string name="core_tx_start">Start</string>
    <string name="core_tx_cancel">Cancel</string>
    <string name="core_tx_stop">Stop</string>
    <string name="core_tx_unavailable">Transmit is not offered on this screen. Transmit from a phone or at the station.</string>
</resources>
